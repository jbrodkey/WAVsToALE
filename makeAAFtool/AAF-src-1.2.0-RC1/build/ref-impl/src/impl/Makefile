	cd /Users/jasonbrodkey/Documents/SFX/pythonScripts/makeAAFtool/AAF-src-1.2.0-RC1/build && $(MAKE) $(MAKESILENT) -f ref-impl/src/impl/CMakeFiles/Impl.dir/build.make ref-impl/src/impl/CMakeFiles/Impl.dir/aafTable.cpp.i
.PHONY : aafTable.cpp.i

aafTable.s: aafTable.cpp.s
.PHONY : aafTable.s

# target to generate assembly for a file
aafTable.cpp.s:
	cd /Users/jasonbrodkey/Documents/SFX/pythonScripts/makeAAFtool/AAF-src-1.2.0-RC1/build && $(MAKE) $(MAKESILENT) -f ref-impl/src/impl/CMakeFiles/Impl.dir/build.make ref-impl/src/impl/CMakeFiles/Impl.dir/aafTable.cpp.s
.PHONY : aafTable.cpp.s

